{
  "name": "base-market-terminal-lite",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone public demo market terminal for Base ecosystem token discovery.",
  "engines": {
    "node": ">=20.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "design:guard": "node scripts/check-design-tokens.mjs",
    "test:design": "node --test tests/design-language-contract.test.mjs",
    "test:onchain": "node --test tests/onchain-discovery-contract.test.mjs",
    "test:enrichment": "node --test tests/enrichment-contract.test.mjs",
    "test:providers": "playwright test -c playwright.provider.config.ts",
    "test:e2e": "playwright test",
    "test": "npm run test:e2e",
    "artifact:prepare": "node scripts/prepare-staging-artifact.mjs",
    "artifact:verify": "node scripts/verify-staging-artifact.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  }
}
