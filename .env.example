# Environment values are optional; the app can switch data sources from the UI.
# URL selection is authoritative; the public app defaults to read-only data.
# DexScreener mode uses public read-only endpoints and no API key.

MARKET_DATA_MODE=dexscreener
# MARKET_DATA_MODE=mock

# Compatibility fallback for older public deployments:
NEXT_PUBLIC_MARKET_DATA_MODE=dexscreener

# Transaction capabilities are server-only and disabled by default. Enable
# these only in a controlled staging unit; production remains read-only.
# MERGEN_QUOTE_ENABLED=true
# MERGEN_SWAP_EXECUTION_ENABLED=true
# LIFI_API_KEY=optional-server-only-key
